# Настройки приложения

PROJECT_NAME=Agent System V2
VERSION=0.2.1
API_V1_STR=/api/v1
ENVIRONMENT=development
DEBUG=true
SQL_ECHO=False

# База данных
DATABASE_URL=postgresql://raguser:ragpass@localhost:5432/ragdb

# База данных
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=raguser
DATABASE_PASSWORD=ragpass
DATABASE_NAME=ragdb

# Embedding модель
# EMBEDDING_MODEL: str = "text-embedding-ada-002"  # OpenAI
# или: EMBEDDING_MODEL: str = "all-MiniLM-L6-v2"  # Sentence transformers

# Размер чанков
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Пути для хранения файлов
UPLOAD_DIR=./uploads
PROCESSED_DIR=./processed

# Безопасность
SECRET_KEY="your-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30